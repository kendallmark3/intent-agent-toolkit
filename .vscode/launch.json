{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "IAT: Run service + console (debug)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["iat.api.app:create_app", "--factory", "--host", "127.0.0.1", "--port", "8000"],
      "envFile": "${workspaceFolder}/.env",
      "cwd": "${workspaceFolder}",
      "justMyCode": true,
      "preLaunchTask": "IAT: Setup (.venv + .env)",
      "serverReadyAction": {
        "pattern": "Uvicorn running on (https?://\\S+)",
        "uriFormat": "%s/ui/",
        "action": "openExternally"
      }
    },
    {
      "name": "IAT: Debug current test file",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["${file}", "-q"],
      "cwd": "${workspaceFolder}",
      "justMyCode": false
    }
  ]
}
