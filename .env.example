# Copy to .env (git-ignored) and fill in. Never commit real values.
# Required: HMAC secret for verifying bearer tokens (min 32 chars). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
IAT_JWT_SECRET=

# Optional
IAT_JWT_ISSUER=iat-local
IAT_JWT_AUDIENCE=iat-api
IAT_LOG_LEVEL=INFO
# Pin the evidence-expiry date for reproducible demos (YYYY-MM-DD). Defaults to today (UTC).
IAT_ASSESSMENT_DATE=
IAT_DOCS_ENABLED=true
# IAT_HOST=127.0.0.1
# IAT_PORT=8000

# Optional: HMAC key for caller pseudonyms in logs (min 32 chars). Derived from IAT_JWT_SECRET when unset.
# Setting it separately lets you rotate the JWT secret without breaking log correlation.
IAT_SUBJECT_PSEUDONYM_KEY=

# Conversation resource bounds (defaults shown)
# IAT_MAX_CONVERSATIONS=1000
# IAT_MAX_CONVERSATIONS_PER_OWNER=50
# IAT_MAX_TURNS_PER_CONVERSATION=40
# IAT_MAX_MESSAGE_CHARS=2000
# IAT_CONVERSATION_IDLE_TTL_SECONDS=3600
