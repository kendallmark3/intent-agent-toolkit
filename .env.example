# Copy to .env (git-ignored) and fill in. Never commit real values.
# Required: HMAC secret for verifying bearer tokens (min 32 chars). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
IAT_JWT_SECRET=

# Optional
IAT_JWT_ISSUER=iat-local
IAT_JWT_AUDIENCE=iat-api
IAT_LOG_LEVEL=INFO
# Pin the evidence-expiry date for reproducible demos (YYYY-MM-DD). Defaults to today (UTC).
IAT_ASSESSMENT_DATE=
IAT_DOCS_ENABLED=true
# IAT_HOST=127.0.0.1
# IAT_PORT=8000
